# 极光推送服务端密钥（Master Secret 是密钥，绝不提交；仅 example 模板入库）
backend/jpush_config.json
.env
.env.*

# Android 签名凭证（包含敏感信息，不提交）
android-credentials.local.sh
*.jks
*.keystore
keystore/
keystore.properties
